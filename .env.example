# ============================================================
# OrbitFlow production environment
# ============================================================
# Recommended for Render/Railway/Neon/Supabase/etc.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Set true only when your PostgreSQL provider requires TLS.
DATABASE_SSL="false"

# Public URL of the deployed application. Used in email links.
APP_URL="http://localhost:3000"

# Authentication secret. Generate a long random value for production.
JWT_SECRET="replace-with-a-long-random-secret"

# SMTP (required for real OTP/welcome/reminder emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"
FROM_EMAIL="your-email@gmail.com"

# Only needed when frontend and backend are deployed separately.
# Leave empty for a single-service deployment where both are on the same origin.
VITE_API_URL=""

# Optional tuning
DATABASE_POOL_MAX="10"
DATABASE_CONNECTION_TIMEOUT_MS="15000"
DATABASE_IDLE_TIMEOUT_MS="30000"
PORT="3000"
NODE_ENV="production"

ENABLE_SCHEDULER="true"
FRONTEND_URL=""
